{
  "name": "castle-gate",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mcp"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "forge": "node scripts/forge-data.mjs",
    "manifest:build": "node scripts/castle-manifest.mjs build",
    "manifest:check": "node scripts/castle-manifest.mjs validate",
    "geometry:check": "node scripts/love-understanding.mjs validate",
    "test": "node --test",
    "verify": "node scripts/castle-manifest.mjs validate && node scripts/love-understanding.mjs validate && node --test && next build"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.20.0",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
